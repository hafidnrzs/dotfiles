{
    "editor.wordWrap": "wordWrapColumn",
    "editor.formatOnSave": true,
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "material-icon-theme",
    "git.confirmSync": false,
    "tailwind-fold.autoFold": false,
    "files.autoSave": "afterDelay",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.tabSize": 2,
    "files.eol": "\n",
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "makefile.configureOnOpen": true,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "chat.mcp.gallery.enabled": true,
    "window.menuBarVisibility": "classic",
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "explorer.confirmDelete": false,
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "default",
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "markdown.preview.scrollEditorWithPreview": false,
    "git.autofetch": true,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/usr/bin/bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "/usr/bin/fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.linux": "fish",
    "claudeCode.useTerminal": true,
    "python.terminal.useEnvFile": true,
    "explorer.confirmDragAndDrop": false,
    "go.toolsManagement.autoUpdate": true,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off",
    "claudeCode.hideOnboarding": true,
    "window.density.layout": "compact",
    "git.blame.editorDecoration.enabled": true,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "intellij.region": "apac",
    "intellij.dataSharing": "anonymous",
    "intellij.additionalJvmArgs": [
        "-Xmx1g"
    ],
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -Xlog:disable",
    "java.imports.gradle.wrapper.checksums": [
        {
            "sha256": "3b8a25775a69158b5ad2b1d17a80a88dc7b40a352a73eb27d06c612a7ce68e98",
            "allowed": true
        }
    ]
}
